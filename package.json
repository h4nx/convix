{
  "name": "convix",
  "version": "0.9.0",
  "private": true,
  "description": "Convix — self-hostable CRM for WhatsApp (H&M Business ecosystem) built on Next.js and PostgreSQL: shared inbox, contacts, sales pipelines, broadcasts, and no-code automations.",
  "license": "MIT",
  "author": "Hans Cruz Buchelli",
  "contributors": [
    "Arnas Donauskas (upstream wacrm template)"
  ],
  "homepage": "https://github.com/h4nx/convix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h4nx/convix.git"
  },
  "bugs": {
    "url": "https://github.com/h4nx/convix/issues"
  },
  "keywords": [
    "crm",
    "whatsapp",
    "whatsapp-business-api",
    "nextjs",
    "postgresql",
    "automation",
    "broadcast",
    "self-hosted"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "gen:routes": "node scripts/gen-routes.mjs",
    "build": "npm run gen:routes && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.server.json --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.5",
    "@hono/node-server": "^1.19.6",
    "@xyflow/react": "^12.11.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "hono": "^4.12.25",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.49.0",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.4",
    "opus-recorder": "^8.0.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "^4.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.1",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "ip-address": "^10.1.1",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.25",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6"
  },
  "type": "module"
}
